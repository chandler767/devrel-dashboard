# ── YouTube ────────────────────────────────────────────────────────────────
# Your channel handle (with or without the @).
# Only YouTube Shorts are fetched. Add long-form videos to manual_videos.json.
# Requires: brew install yt-dlp

YOUTUBE_HANDLE=

# ── TikTok ─────────────────────────────────────────────────────────────────
# Your TikTok username (without the @).
# Requires: brew install yt-dlp

TIKTOK_USERNAME=

# ── LinkedIn (Community Management API) ───────────────────────────────────────
# OAuth 2.0 credentials — create an app at https://developer.linkedin.com
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Access token from the OAuth authorization code flow.
# Run `go run ./cmd/fetch --linkedin-auth` to get these automatically.
# Auto-refreshed on each run when CLIENT_ID + REFRESH_TOKEN are present.
LINKEDIN_ACCESS_TOKEN=

# Refresh token (~1 year lifetime). Used to generate new access tokens automatically.
LINKEDIN_REFRESH_TOKEN=

# Optional: your person URN (urn:li:person:{numericId}) to fetch personal video posts.
# Get the numeric ID from: GET https://api.linkedin.com/v2/userinfo → "sub" field.
# Leave blank to skip personal posts.
LINKEDIN_PERSON_URN=

# Optional: LinkedIn Pages you manage (comma-separated organization URNs).
# Find your org ID from the admin URL: linkedin.com/company/12345678/admin/
# The URN format is: urn:li:organization:12345678
LINKEDIN_ORG_URNS=

# ── Anthropic (Content Intelligence) ──────────────────────────────────────────
# Used to generate AI analysis of your videos on each report run.
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model used for analysis.
# Defaults to claude-haiku-4-5-20251001 (fast + affordable).
# ANTHROPIC_MODEL=claude-sonnet-4-6
